{
  "name": "catering-events-website",
  "version": "1.4.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.3 || ^26.13.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "npm run clean:build && astro build",
    "preview": "astro preview",
    "validate": "npm run clean:build && npm run check && npm run build",
    "test": "playwright test",
    "test:report": "playwright show-report",
    "test:install": "playwright install chromium",
    "audit:assets": "node scripts/asset-budget.mjs",
    "qa": "npm test && npm run audit:assets",
    "test:navigation": "playwright test tests/navigation.spec.ts",
    "test:performance": "playwright test tests/performance.spec.ts",
    "clean:build": "node scripts/clean-build.mjs",
    "test:layout": "playwright test tests/layout.spec.ts",
    "test:typography": "playwright test tests/typography.spec.ts"
  },
  "dependencies": {
    "astro": "7.4.13",
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource-variable/playfair-display": "^5.2.0",
    "@fontsource/tangerine": "^5.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "typescript": "6.0.3",
    "@playwright/test": "1.65.1",
    "@axe-core/playwright": "4.14.0"
  }
}
