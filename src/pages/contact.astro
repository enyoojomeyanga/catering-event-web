---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/shared/PageHero.astro';
import Button from '../components/ui/Button.astro';
import ContactForm from '../components/shared/ContactForm.astro';
import {business} from '../data/business';
import {whatsappLink} from '../lib/whatsapp';
const international=(phone:string)=>`+234 ${phone.slice(1,4)} ${phone.slice(4,7)} ${phone.slice(7)}`;
---
<BaseLayout title="Contact" description="Send an email enquiry, chat on WhatsApp or find our offices in Idah and Anyigba, Kogi State.">
<section class="section container split contact-layout" aria-labelledby="page-title"><PageHero title="Contact Us" align="center" fullRow/><div class="stack-large"><div class="stack"><h2>Get in touch</h2><p>Share your event date, the services you need and any questions about your order.</p></div><div class="contact-entry"><span class="contact-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 6 9 7 9-7"/></svg></span><div><h3>Email</h3><a href={`mailto:${business.email}`}>{business.email}</a></div></div><div class="contact-entry"><span class="contact-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 3h4l2 5-3 2c1 3 3 5 6 6l2-3 5 2v4c0 2-2 2-4 2C9 20 4 15 3 7 3 5 3 3 5 3Z"/></svg></span><div><h3>Phone</h3>{business.phones.map(phone=><a href={`tel:+234${phone.slice(1)}`}>{international(phone)}</a>)}</div></div><div class="contact-entry"><span class="contact-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg></span><div><h3>Our offices</h3>{business.offices.map(office=><div class="office"><strong>{office.label}</strong><address>{office.address}</address></div>)}</div></div><div class="stack"><h3>Prefer to chat?</h3><p>Discuss your plans and confirm booking arrangements on WhatsApp.</p><div><Button href={whatsappLink()}>Chat on WhatsApp</Button></div></div></div><ContactForm/></section>
</BaseLayout>
<style>.contact-layout{align-items:start;row-gap:var(--action-gap)}.contact-entry{display:grid;grid-template-columns:44px minmax(0,1fr);gap:.75rem;align-items:start}.contact-icon{width:44px;height:44px;display:grid;place-items:center;border-radius:50%;background:var(--lavender-soft);color:var(--accent-ink)}.contact-entry h3{font:600 var(--type-link)/1.5 var(--font-body);letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:.25rem}.contact-entry a{display:flex;align-items:center;min-height:44px;overflow-wrap:anywhere}.office{margin-block:.75rem;color:var(--muted)}address{font-style:normal}</style>
