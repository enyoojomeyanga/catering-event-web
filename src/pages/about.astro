---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/shared/PageHero.astro';
import BookingCTA from '../components/shared/BookingCTA.astro';
import ResponsiveImage from '../components/media/ResponsiveImage.astro';
import TestimonialSection from '../components/portfolio/TestimonialSection.astro';
import { illustrations } from '../data/illustrations';
import { business } from '../data/business';
import { publishedProjects } from '../lib/portfolio';
const projects=await publishedProjects();
const approach=[
  {title:'Tell us what you need',text:'Share your date, preferred services and the details of your occasion.',path:'M4 5h16v11H9l-5 4V5Z'},
  {title:'Discuss the arrangements',text:'Talk through your requirements, availability and a quotation with us.',path:'M5 4h14v16H5zM8 9h8M8 13h8M8 17h5'},
  {title:'Confirm your booking',text:'Agree on the arrangements and any deposit required before your booking is confirmed.',path:'M4 12l5 5L20 6'},
];
---
<BaseLayout title="About" description="Learn about Flourish Catering and Events Services and how to arrange a booking.">
  <section class="section container split about-intro about-first" aria-labelledby="page-title" data-reveal>
    <div class="stack"><PageHero title="About Us"/><h2>Who we are</h2><p>{business.registeredName} provides catering, indoor and outdoor event decoration, custom cakes, small chops and confectionery.</p><p>Some occasions call for a full arrangement, while others simply need a cake or something to serve guests. You can book any of our four services individually or combine them for the same event.</p><p>We work with requests for different kinds of occasions and can discuss individual orders as well.</p></div>
    <figure class="media-frame"><ResponsiveImage photo={illustrations[9].photo} kind="service"/></figure>
  </section>
  <section class="section soft-section"><div class="container stack-large"><div class="center-heading" data-reveal><h2>Our approach</h2><p>Here is how to arrange a booking with us.</p></div><div class="approach-grid">{approach.map(item=><article class="approach-card stack" data-reveal><span class="approach-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={item.path}/></svg></span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></div></section>
  <section class="section container split about-intro" data-reveal><figure class="media-frame"><ResponsiveImage photo={illustrations[8].photo} kind="service"/></figure><div class="stack"><h2>Planning ahead</h2><p>We recommend contacting us at least two weeks before your occasion. Last-minute requests may be possible depending on availability.</p><p>Quotes are based on your requirements, rather than a fixed package. Tell us what you have in mind and we can discuss the options.</p><a href="/services">See what we offer</a></div></section>
  <TestimonialSection projects={projects}/>
  <BookingCTA/>
</BaseLayout>
<style>.about-intro{align-items:center}.about-first{align-items:start}.approach-grid{display:grid;gap:var(--grid-gap)}.approach-card{background:white;border:1px solid var(--border);border-radius:var(--radius);padding:clamp(1.25rem,2vw,1.5rem);align-content:start}.approach-icon{display:grid;place-items:center;width:44px;height:44px;color:var(--accent-ink);background:var(--lavender-soft);border-radius:50%}@media(min-width:48rem){.approach-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}</style>
