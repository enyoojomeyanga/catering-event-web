---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingCTA from '../components/shared/BookingCTA.astro';
import { business } from '../data/business';
---
<BaseLayout title="About" description="Learn about Flourish Catering and Events Services."><section class="section container stack-large"><div class="stack"><h1>About us</h1><p class="lead">{business.registeredName} provides catering, indoor and outdoor event decoration, custom cakes, small chops and confectionery.</p><p>Book the services you need for your event, or contact us about a separate cake or small chops order.</p></div><div class="stack"><h2>Where we operate</h2><p>Our offices are in Idah and Anyigba, Kogi State. We primarily serve Kogi State and Abuja, with arrangements available across Nigeria.</p><p><a href="/contact">View office addresses</a></p></div></section><BookingCTA/></BaseLayout>
