---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/shared/PageHero.astro';
import Button from '../components/ui/Button.astro';
---
<BaseLayout indexable={false} title="Page not found" description="The requested page could not be found."><section class="section container stack" aria-labelledby="page-title"><PageHero title="Page not found"/><p>The page you requested is unavailable. Explore our services or return to the homepage.</p><div class="action-row"><Button href="/">Back to home</Button><Button href="/services" variant="secondary">Explore services</Button></div></section></BaseLayout>
