---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqAccordion from '../components/shared/FaqAccordion.astro';
import BookingCTA from '../components/shared/BookingCTA.astro';
import { faqs } from '../data/faqs';
---
<BaseLayout title="FAQs | Catering & Events" description="Answers to common questions about bookings, quotations, independent orders.">
 <section class="section container stack-large"><div class="stack"><h1>FAQs</h1></div><FaqAccordion items={faqs}/></section>
 <BookingCTA title="Have another question?" />
</BaseLayout>
