---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/shared/PageHero.astro';
import FaqAccordion from '../components/shared/FaqAccordion.astro';
import BookingCTA from '../components/shared/BookingCTA.astro';
import {faqs} from '../data/faqs';
---
<BaseLayout title="FAQs" description="Answers to common questions about bookings, quotations and independent orders."><PageHero title="Frequently asked questions"/><section class="section container"><FaqAccordion items={faqs}/></section><BookingCTA title="Have another question?"/></BaseLayout>
