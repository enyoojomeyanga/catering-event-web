---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import BookingSteps from '../components/home/BookingSteps.astro';
import ServiceGrid from '../components/services/ServiceGrid.astro';
import SectionHeading from '../components/shared/SectionHeading.astro';
import FaqAccordion from '../components/shared/FaqAccordion.astro';
import BookingCTA from '../components/shared/BookingCTA.astro';
import Button from '../components/ui/Button.astro';
import { faqs } from '../data/faqs';
import { publishedProjects } from '../lib/portfolio';
import ProjectSection from '../components/portfolio/ProjectSection.astro';
import TestimonialSection from '../components/portfolio/TestimonialSection.astro';
const projects=await publishedProjects();
---
<BaseLayout title="Catering & Events" description="Catering, event decoration, custom cakes and small chops for your occasion.">
<HomeHero />
<section class="section container stack-large"><SectionHeading title="Our services" description="Choose one service or arrange several for the same event."/><ServiceGrid/></section>
<ProjectSection projects={projects.filter(p=>p.data.featured)}/>
<section class="section container ruled split"><h2>About us</h2><div class="stack"><p>We help customers plan the food, decoration and treats for their events. You can also order cakes or small chops separately.</p><div><Button href="/about" variant="text">About the business</Button></div></div></section>
<TestimonialSection projects={projects}/>
<section class="section container stack-large"><h2>How to book</h2><BookingSteps/></section>
<section class="section container ruled stack-large"><h2>FAQs</h2><FaqAccordion items={faqs.slice(0,3)}/><div><Button href="/faq" variant="text">View all FAQs</Button></div></section>
<BookingCTA/>
</BaseLayout>
