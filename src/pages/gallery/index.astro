---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/shared/PageHero.astro';
import BookingCTA from '../../components/shared/BookingCTA.astro';
import CategoryCards from '../../components/portfolio/CategoryCards.astro';
import {publishedProjects} from '../../lib/portfolio';
import {services} from '../../data/services';
const projects=await publishedProjects();
---
<BaseLayout indexable={projects.length>0} title="Portfolio" description="Browse service imagery and completed projects when available.">
<section class="section container stack-large" data-gallery aria-labelledby="page-title"><PageHero title="Our Portfolio" description="Browse the collections for each of our services."/>{services.some(service=>!projects.some(project=>project.data.services.includes(service.slug)))&&<p class="photo-note">Some collections contain illustrative imagery for inspiration, not photographs of completed client work.</p>}<CategoryCards/></section><BookingCTA/>
</BaseLayout>
