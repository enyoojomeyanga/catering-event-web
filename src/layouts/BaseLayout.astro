---
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/playfair-display/wght.css';
import '@fontsource-variable/playfair-display/wght-italic.css';
import '@fontsource/tangerine/400.css';
import '../styles/global.css';
import LoadingExperience from '../components/shared/LoadingExperience.astro';
import Header from '../components/navigation/Header.astro';
import BackToTop from '../components/navigation/BackToTop.astro';
import Footer from '../components/navigation/Footer.astro';
import { business } from '../data/business';
import { businessSchema, canIndex, canonicalUrl } from '../lib/seo';
interface Props { title: string; description: string; indexable?: boolean; }
const { title, description, indexable = true } = Astro.props;
const index = canIndex && indexable;
const canonical = index ? canonicalUrl(Astro.url.pathname) : undefined;
const schema = index && Astro.url.pathname === '/' ? businessSchema() : undefined;
const brand = business.displayName ?? business.registeredName;
const pageTitle = title.replace(/ \| Catering & Events$/, '') + ` | ${brand}`;
---
<!doctype html>
<html lang="en-NG">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={index ? 'index, follow' : 'noindex, follow'} />
    <title>{pageTitle}</title>
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_NG" />
    <meta property="og:site_name" content={brand} />
    <meta name="twitter:card" content="summary" />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {schema && <script type="application/ld+json" is:inline set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />}
  </head>
  <body id="page-top">
    <LoadingExperience />
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
    <BackToTop />
    <script>
      import '../scripts/image-loading';
      // Content is visible by default; reveals are enhancement only.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(entries => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('revealed');
            observer.unobserve(entry.target);
          }
        }, { threshold: 0.12 });
        document.querySelectorAll('[data-reveal]').forEach(element => observer.observe(element));
      }
    </script>
  </body>
</html>
