---
const steps = [{title:'Choose your services',description:'Select one service or combine several.'},{title:'Discuss your occasion',description:'Share your requirements with the team on WhatsApp.'},{title:'Confirm your arrangements',description:'Agree on availability, requirements and pricing directly with the team.'}];
---
<ol class="steps">{steps.map((step,i)=><li><span class="step-number" aria-hidden="true">0{i+1}</span><h3>{step.title}</h3><p>{step.description}</p></li>)}</ol>
<style>.steps { list-style:none; margin:0; padding:0; display:grid; gap:1.5rem; } li { display:grid; gap:.75rem; border-top:1px solid var(--border-decorative); padding-top:1rem; } .step-number { font-size:2rem; font-family:var(--font-editorial); font-style:italic; } @media(min-width:48rem){ .steps { grid-template-columns:repeat(3,minmax(0,1fr)); } }</style>
