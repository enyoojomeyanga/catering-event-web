---
import Button from '../ui/Button.astro';
import { whatsappLink } from '../../lib/whatsapp';
import { business } from '../../data/business';
import { publishedProjects } from "../../lib/portfolio";
import ResponsiveImage from "../media/ResponsiveImage.astro";
const hero = (await publishedProjects()).find(p=>p.data.featured)?.data.cover;
---
<section class="section home-hero"><div class="container hero-inner"><div class="hero-copy"><p class="eyebrow">Catering · Design · Celebration</p><h1>Bringing everything <span class="editorial">beautiful together.</span></h1><span class="accent-rule" aria-hidden="true"></span><p class="lead">Catering, event decoration, custom cakes and confectionery for occasions across Nigeria.</p><div class="action-row"><Button href={whatsappLink()}>Book on WhatsApp</Button><Button href="/services" variant="text">Explore our services <span aria-hidden="true">↗</span></Button></div></div><aside class="hero-note"><p class="eyebrow">Four specialties. One team.</p><p class="editorial motto">{business.motto}.</p><p>Serving Kogi State, Abuja and customers across Nigeria.</p></aside></div>{hero && <div class="container hero-media"><ResponsiveImage photo={hero} kind="hero" eager/></div>}</section>
<style>
.hero-media { margin-top:2rem; } .hero-inner { display:grid; gap:clamp(2rem,6vw,6rem); align-items:end; } .hero-copy { display:grid; gap:1.35rem; } h1 { font-size:var(--type-display); max-width:18ch; line-height:1.1; } h1 span { display:block; } .hero-note { border-top:1px solid var(--border-interactive); padding-top:1.5rem; display:grid; gap:1rem; } .motto { font-size:clamp(2rem,4vw,3.5rem); line-height:1.15; } @media(min-width:64rem) { .hero-inner { grid-template-columns:minmax(0,2fr) minmax(0,1fr); } }
</style>
