---
import Button from '../ui/Button.astro';
import { whatsappLink } from '../../lib/whatsapp';
import { publishedProjects } from '../../lib/portfolio';
import ResponsiveImage from '../media/ResponsiveImage.astro';
import { heroIllustration } from '../../data/illustrations';
const cover = (await publishedProjects()).find(p=>p.data.featured)?.data.cover;
---
<section class="section home-hero container">
 <div class="hero-copy"><h1>Making your occasions <span class="editorial">special.</span></h1><p class="lead">Planning an event or ordering something for a celebration? We can help with catering, decoration, cakes and small chops.</p><div class="action-row"><Button href={whatsappLink()}>Book on WhatsApp</Button><Button href="/services" variant="text">Explore services</Button></div></div>
 <figure class:list={[!cover && "illustrative"]}><ResponsiveImage photo={cover ?? heroIllustration} kind="hero" eager/>{!cover && <figcaption>AI-generated illustration, not a photograph of our work.</figcaption>}</figure>
</section>
<style>.home-hero{display:grid;gap:clamp(1.75rem,4vw,3rem)}.hero-copy{display:grid;gap:1.25rem;max-width:70ch}.hero-copy h1{font-size:var(--type-display);max-width:24ch}.hero-copy .action-row{margin-top:.5rem}figure{margin:0}.illustrative{width:100%;max-width:48rem}figcaption{font-size:.875rem;margin-top:.5rem}</style>
