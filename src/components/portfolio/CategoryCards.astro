---
import {services} from '../../data/services';
import {serviceIllustrations} from '../../data/illustrations';
import {publishedProjects} from '../../lib/portfolio';
import ResponsiveImage from '../media/ResponsiveImage.astro';
const projects=await publishedProjects();
interface Props{compact?:boolean;}
const {compact=false}=Astro.props;
---
<div class:list={['category-grid',{compact}]}>{services.map(service=>{const cover=projects.find(p=>p.data.services.includes(service.slug))?.data.cover;return <article class="category" data-reveal><a href={`/gallery/category/${service.slug}`} class="category-link"><div class="category-photo"><ResponsiveImage photo={cover??serviceIllustrations(service.slug)[0].photo} kind="service" responsiveSizes={compact ? '(min-width: 81rem) 282px, (min-width: 64rem) 23vw, (min-width: 40rem) 45vw, 92vw' : '(min-width: 81rem) 588px, (min-width: 40rem) 45vw, 92vw'}/></div><div class="category-caption"><h3>{service.title}</h3><span>View gallery</span></div></a></article>})}</div>
<style>
.category-grid{display:grid;gap:var(--grid-gap)}.category{min-width:0}
.category-link{display:flex;flex-direction:column;height:100%;overflow:hidden;border:1px solid var(--border);border-radius:var(--image-radius);background:var(--white);text-decoration:none}
.category-photo{overflow:hidden;aspect-ratio:4/3;flex:none;min-width:0;background:var(--lavender-soft)}
.category-link :global(img){display:block;width:100%;height:100%;border-radius:0;aspect-ratio:4/3;object-fit:cover;transition:transform 450ms ease;filter:none}
.category-caption{position:relative;display:grid;gap:.5rem;padding:clamp(1rem,2vw,1.5rem);background:var(--white);flex:1;align-content:start}
.category-caption h3{font-size:var(--type-h3);color:var(--plum)}.category-caption span{font-size:var(--type-link);color:var(--accent-ink)}
.category-link:hover .category-caption span{color:var(--plum);font-weight:600}@media(hover:hover) and (pointer:fine) and (prefers-reduced-motion:no-preference){.category-link:hover :global(img){transform:scale(1.025)}}.category:nth-child(2).revealed{animation-delay:80ms}.category:nth-child(3).revealed{animation-delay:160ms}.category:nth-child(4).revealed{animation-delay:240ms}.category-link:focus-visible{outline-offset:4px}
@media(min-width:40rem){.category-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(min-width:64rem){.compact{grid-template-columns:repeat(4,minmax(0,1fr))}.compact .category-caption{padding:1rem}.compact .category-caption h3{font-size:clamp(1.5rem,1.9vw,1.75rem)}}
</style>
