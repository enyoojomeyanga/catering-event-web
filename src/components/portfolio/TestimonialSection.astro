---
import type { Project } from '../../lib/portfolio';
interface Props { projects: Project[]; }
const { projects } = Astro.props;
const entries = projects.filter(p=>p.data.testimonial?.permission).slice(0,3);
---
{entries.length > 0 && <section class="section container ruled stack-large"><h2>Client testimonials</h2><div class="quotes">{entries.map(p=><figure class="stack"><blockquote class="editorial">“{p.data.testimonial?.quote}”</blockquote><figcaption>{p.data.testimonial?.attribution} · <a href={`/gallery/${p.id}`}>{p.data.title}</a></figcaption></figure>)}</div></section>}
<style>
.quotes { display:grid; gap:var(--grid-gap); } figure { border:1px solid var(--border); border-radius:var(--radius); background:var(--lavender-soft); padding:clamp(1.25rem,2vw,1.5rem); margin:0; } blockquote { font:400 var(--type-body)/1.65 var(--font-body); margin:0; } @media(min-width:64rem){ .quotes { grid-template-columns:repeat(3,minmax(0,1fr)); } }
</style>
