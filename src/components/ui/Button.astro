---
interface Props {href?:string;variant?:'primary'|'secondary'|'text'|'inverse';type?:'button'|'submit';}
const {href,variant='primary',type='button'}=Astro.props;
---
{href?<a class:list={['action',variant]} href={href}><slot/></a>:<button class:list={['action',variant]} type={type}><slot/></button>}
<style>.action{display:inline-flex;align-items:center;justify-content:center;min-height:var(--target-min);padding:.7rem clamp(1rem,2vw,1.5rem);max-width:100%;border:1px solid var(--border-interactive);border-radius:100vw;font-size:var(--type-link);font-weight:500;line-height:1.4;text-align:center;text-decoration:none;background:transparent;color:var(--plum);transition:background-color 250ms,color 250ms,border-color 250ms,transform 250ms}.primary,.inverse{background:var(--lavender);border-color:var(--lavender)}.primary:hover,.inverse:hover{background:var(--border);border-color:var(--accent-ink)}.secondary:hover{background:var(--lavender-soft)}.text{padding-inline:0;border-color:transparent;text-decoration:none;color:var(--accent-ink)}.text:hover{color:var(--plum);background:var(--lavender-soft)}@media(hover:hover) and (prefers-reduced-motion:no-preference){.action:hover{transform:translateY(-2px)}} </style>
