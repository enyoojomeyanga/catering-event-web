---
interface Props {href?:string;variant?:'primary'|'secondary'|'text'|'inverse';type?:'button'|'submit';}
const {href,variant='primary',type='button'}=Astro.props;
---
{href?<a class:list={['action',variant]} href={href}><slot/></a>:<button class:list={['action',variant]} type={type}><slot/></button>}
<style>.action{display:inline-flex;align-items:center;justify-content:center;min-height:var(--target-min);padding:.7rem 1.5rem;border:1px solid var(--border-interactive);border-radius:100vw;font-size:.875rem;font-weight:500;line-height:1.4;text-align:center;text-decoration:none;background:transparent;color:var(--plum);transition:background-color 200ms,color 200ms,border-color 200ms}.primary,.inverse{background:var(--lavender);border-color:var(--lavender)}.primary:hover,.inverse:hover{background:var(--border);border-color:var(--accent-ink)}.secondary:hover{background:var(--lavender-soft)}.text{padding-inline:0;border-color:transparent;text-decoration:underline;color:var(--accent-ink)}.text:hover{text-decoration-thickness:2px}</style>
