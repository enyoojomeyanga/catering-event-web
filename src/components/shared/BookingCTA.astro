---
import Button from '../ui/Button.astro';
import Section from '../ui/Section.astro';
import { whatsappLink } from '../../lib/whatsapp';
interface Props { message?: string; title?: string; }
const { message, title = 'Discuss your occasion' } = Astro.props;
---
<Section inverse><div class="booking"><div class="stack"><h2>{title}</h2><p>Tell us what you need and we can discuss availability and pricing.</p></div><div><Button href={whatsappLink(message)} variant="inverse">Book on WhatsApp</Button></div></div></Section>
<style>.booking { display:grid; gap:1.5rem; align-items:center; } @media(min-width:48rem){ .booking { grid-template-columns:minmax(0,2fr) auto; } }</style>
