---
interface Props {items:readonly {question:string;answer:string}[];}
const {items}=Astro.props;
---
<div class="faq-list">{items.map(item=><details><summary>{item.question}<span class="indicator" aria-hidden="true"></span></summary><p>{item.answer}</p></details>)}</div>
<style>.faq-list{width:min(100%,50rem);margin-inline:auto;display:grid;gap:.75rem}details{border:1px solid var(--border);border-radius:var(--radius);background:var(--white)}summary{display:flex;align-items:center;justify-content:space-between;gap:1rem;min-height:44px;padding:1rem 1.25rem;font-weight:500;cursor:pointer;list-style:none;font-size:.9375rem}summary::-webkit-details-marker{display:none}.indicator{color:var(--accent-ink)}.indicator::before{content:'+';font-size:1.5rem;line-height:1}details[open] .indicator::before{content:'−'}details p{padding:0 1.25rem 1.25rem}</style>
