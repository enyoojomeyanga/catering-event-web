---
interface Props { title: string; description?: string; align?: 'left' | 'center'; fullRow?: boolean; }
const {title,description,align='left',fullRow=false}=Astro.props;
---
<header class:list={['page-heading', {centered:align==='center','full-row':fullRow}]}><h1 id="page-title">{title}</h1>{description&&<p>{description}</p>}</header>
