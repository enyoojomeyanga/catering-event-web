---
interface Props { items: readonly { label: string; href?: string }[]; }
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="container breadcrumbs"><ol>{items.map((item) => <li>{item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}</li>)}</ol></nav>
<style>
.breadcrumbs { padding-block:1rem 0; font-size:.875rem; } ol { display:flex; flex-wrap:wrap; align-items:center; gap:.5rem; list-style:none; padding:0; margin:0; } li { display:flex; align-items:center; gap:.5rem; } li+li::before { content:'/'; } a { display:inline-flex; align-items:center; min-height:44px; } 
</style>
