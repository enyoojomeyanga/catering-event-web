---
import { services, type Service } from '../../data/services';
import { publishedProjects } from '../../lib/portfolio';
import { serviceIllustrations } from '../../data/illustrations';
import ResponsiveImage from '../media/ResponsiveImage.astro';
interface Props { items?: readonly Service[]; }
const { items = services } = Astro.props;
const projects = await publishedProjects();
---
<div class="service-grid">{items.map(service=>{const cover=projects.find(p=>p.data.services.includes(service.slug))?.data.cover; const photo=cover ?? serviceIllustrations(service.slug)[0].photo;return <article class="service-card"><figure><ResponsiveImage photo={photo} kind="service"/>{!cover&&<figcaption>AI-generated illustration</figcaption>}</figure><h3><a href={`/services/${service.slug}`}>{service.title}</a></h3><p>{service.description}</p></article>})}</div>
<style>.service-grid{display:grid;gap:clamp(1.5rem,3vw,2.5rem)}.service-card{display:grid;align-content:start;gap:.75rem;padding-bottom:1.25rem;border-bottom:1px solid var(--border-decorative)}figure{margin:0}figcaption{font-size:.8125rem;margin-top:.4rem}h3 a{display:inline-flex;align-items:center;min-height:44px;text-decoration:underline} @media(min-width:40rem){.service-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}</style>
