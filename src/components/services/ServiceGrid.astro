---
import {services,type Service} from '../../data/services';
interface Props{items?:readonly Service[];}
const {items=services}=Astro.props;
const symbols={catering:'M4 17h16M5 16a7 7 0 0 1 14 0M12 7V5M3 19h18',decoration:'M12 12c-7-8 8-8 0 0 8-7 8 8 0 0 7 8-8 8 0 0-8 7-8-8 0 0',baking:'M4 20h16v-8H4zM4 15c2 2 4 2 8 0 4 2 6 2 8 0M12 12V7M12 4v1',confectionery:'M8 8h8v8H8zM8 8 3 5v14l5-3M16 8l5-3v14l-5-3'};
---
<div class="service-grid">{items.map(service=><article class="service-card" data-reveal><div class="service-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"><path d={symbols[service.slug]}/></svg></div><h3><a href={`/services#${service.slug}`}>{service.title}</a></h3><p>{service.description}</p></article>)}</div>
<style>.service-grid{display:grid;gap:1.25rem}.service-card{display:grid;align-content:start;gap:.75rem;padding:1.5rem;border:1px solid var(--border);border-radius:var(--radius);transition:border-color 200ms,box-shadow 200ms}.service-card:nth-child(2).revealed{animation-delay:80ms}.service-card:nth-child(3).revealed{animation-delay:160ms}.service-card:nth-child(4).revealed{animation-delay:240ms}.service-card:hover{border-color:var(--lavender);box-shadow:0 6px 18px #1f1b2e08}.service-icon{width:44px;height:44px;display:grid;place-items:center;color:var(--accent-ink);border-radius:.65rem;background:var(--lavender-soft)}h3 a{display:flex;align-items:center;min-height:44px;text-decoration:none}h3 a:hover{text-decoration:underline}.service-card p{font-size:.9375rem}@media(min-width:40rem){.service-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(min-width:70rem){.service-grid{gap:1.5rem}}</style>
