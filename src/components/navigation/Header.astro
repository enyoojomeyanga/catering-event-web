---
import { business } from '../../data/business';
import { services } from '../../data/navigation';
import { whatsappLink } from '../../lib/whatsapp';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const active = (href: string) => path === href ? 'page' : undefined;
const servicesActive = path === '/services' || path.startsWith('/services/');
const name = business.displayName ?? business.registeredName;

---
<header class="site-header" data-header>
  <div class="header-surface">
  <div class="container header-row">
    <a class="brand" href="/" aria-label={`${name} home`}>{name}</a>
    <nav aria-label="Primary" class="desktop-nav">
      <a href="/" aria-current={active('/')}>Home</a>
      <details class="services-menu" data-disclosure>
        <summary class:list={[{ 'section-active': servicesActive }]}>Services <span class="chevron" aria-hidden="true"></span></summary>
        <div class="service-panel">
          {services.map(service => <a href={`/services/${service.slug}`} aria-current={active(`/services/${service.slug}`)}>{service.title}</a>)}
          <a class="all-services" href="/services" aria-current={active('/services')}>All services</a>
        </div>
      </details>
      <a href="/gallery" aria-current={active("/gallery")}>Gallery</a><a href="/about" aria-current={active('/about')}>About</a>
      <a href="/contact" aria-current={active('/contact')}>Contact</a>
    </nav>
    <a class="enquire" href={whatsappLink()}>Enquire<span class="wide-label"> now</span></a>
    <details class="mobile-nav" data-disclosure>
      <summary>Menu <span aria-hidden="true">☰</span></summary>
      <nav aria-label="Mobile primary" class="mobile-panel">
        <a href="/" aria-current={active('/')}>Home</a>
        <div class="mobile-service-group" role="group" aria-labelledby="mobile-services-label">
          <p id="mobile-services-label" class:list={['mobile-services-label', { 'section-active': servicesActive }]}>Services</p>
          <div class="mobile-services"><a href="/services" aria-current={active('/services')}>All services</a>{services.map(service => <a href={`/services/${service.slug}`} aria-current={active(`/services/${service.slug}`)}>{service.title}</a>)}</div>
        </div>
        <a href="/gallery" aria-current={active("/gallery")}>Gallery</a><a href="/about" aria-current={active('/about')}>About</a><a href="/contact" aria-current={active('/contact')}>Contact</a>
      </nav>
    </details>
  </div>
  </div>
</header>
<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const disclosures = Array.from(header.querySelectorAll<HTMLDetailsElement>('[data-disclosure]'));
    const close = (item: HTMLDetailsElement, restore = false) => {
      item.open = false;
      if (restore) item.querySelector<HTMLElement>(':scope > summary')?.focus();
    };
    // Do not close on focusout: touch activation can move focus before a click.
    // Only a completed outside click or deliberate keyboard focus movement dismisses.
    let keyboardNavigation = false;
    document.addEventListener('pointerdown', () => { keyboardNavigation = false; });
    document.addEventListener('click', event => {
      const path = event.composedPath();
      for (const item of disclosures) {
        if (item.open && !path.includes(item)) close(item);
      }
    });
    document.addEventListener('focusin', event => {
      if (!keyboardNavigation || !(event.target instanceof Node)) return;
      for (const item of disclosures) {
        if (item.open && !item.contains(event.target)) close(item);
      }
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Tab') keyboardNavigation = true;
      if (event.key !== 'Escape') return;
      const target = document.activeElement;
      const open = disclosures.filter(item => item.open && item.contains(target)).at(-1)
        ?? disclosures.find(item => item.open);
      if (open) { event.preventDefault(); close(open, true); }
    });
    const breakpoint = matchMedia('(min-width: 75rem)');
    breakpoint.addEventListener('change', () => disclosures.forEach(item => close(item)));
    // A fixed minimum outer footprint prevents scroll anchoring feedback.
    // Hysteresis prevents rapid state changes near the compact threshold.
    const update = () => {
      const y = window.scrollY;
      if (y >= 112) header.classList.add('compact');
      else if (y <= 56) header.classList.remove('compact');
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>
<style>
.site-header { --header-reserve:4.5rem; position:sticky; top:0; z-index:20; min-block-size:calc(var(--header-reserve) + 1px); flex-shrink:0; pointer-events:none; }
.header-surface { background:var(--surface-page); border-bottom:1px solid var(--border-decorative); pointer-events:auto; }
.header-row { display:grid; grid-template-columns:minmax(0,1fr) auto auto; align-items:center; gap:.65rem; min-height:var(--header-reserve); padding-block:.5rem; position:relative; }
.compact .header-row { min-height:3.75rem; }
.brand { min-height:44px; display:flex; align-items:center; font-weight:600; font-size:clamp(.75rem,1.25vw,1rem); line-height:1.3; text-decoration:none; padding-block:.5rem; overflow-wrap:anywhere; }
.enquire { background:var(--action-primary-bg); color:var(--action-primary-text); text-decoration:none; font-size:.85rem; font-weight:600; padding:.65rem .7rem; min-height:44px; display:flex; align-items:center; white-space:nowrap; }
nav a, summary { min-height:44px; display:flex; align-items:center; padding:.5rem .65rem; text-decoration:none; font-weight:500; font-size:.95rem; }
summary { cursor:pointer; list-style:none; gap:.35rem; } summary::-webkit-details-marker { display:none; }
nav a:hover, summary:hover, [aria-current='page'], .section-active { text-decoration:underline; text-underline-offset:.3em; }
.desktop-nav,.wide-label { display:none; }
 .mobile-panel,.service-panel { position:absolute; top:100%; background:var(--surface-page); border:1px solid var(--border-decorative); max-height:calc(100dvh - 6rem); overflow:auto; overscroll-behavior:contain; }
.mobile-panel { inset-inline:var(--page-padding); padding:.5rem; }
details:not([open]) > .mobile-panel, details:not([open]) > .service-panel { display:none; }
.mobile-panel > a,.mobile-service-group { border-bottom:1px solid var(--border-decorative); }
.mobile-panel > a:last-child { border-bottom:0; }
.mobile-services-label { font-weight:600; padding:.75rem .65rem .25rem; font-size:.95rem; }
.mobile-services { padding-inline-start:.75rem; padding-block-end:.5rem; }
.mobile-services a { font-size:.9rem; }
.service-panel a:hover,.mobile-panel a:hover { background:var(--surface-accent); color:var(--text-on-muted); }
.service-panel a:focus-visible,.mobile-panel a:focus-visible { outline-offset:-3px; }
.chevron { width:.42rem; height:.42rem; border-right:1.5px solid currentColor; border-bottom:1.5px solid currentColor; transform:rotate(45deg); margin-inline-start:.15rem; margin-block-start:-.2rem; flex:none; }
.services-menu[open] .chevron { transform:rotate(225deg); margin-block-start:.2rem; }
@media(min-width:75rem) {
  .site-header { --header-reserve:5rem; }
  .header-row { grid-template-columns:minmax(12rem,1fr) auto auto; gap:1.5rem; }
  .compact .header-row { min-height:4rem; }
  .desktop-nav { display:flex; align-items:center; grid-column:2; grid-row:1; gap:.5rem; }
  .enquire { grid-column:3; grid-row:1; padding-inline:1.25rem; }
  .wide-label { display:inline; white-space:pre; }
  .mobile-nav { display:none; }
  .services-menu { position:relative; }
  .service-panel { width:280px; inset-inline-start:0; padding:.5rem; }
  .service-panel a { padding-inline:.75rem; }
  .all-services { border-top:1px solid var(--border-decorative); margin-top:.25rem; font-weight:600; }
}
@media(prefers-reduced-motion:no-preference) {
  .services-menu[open] .service-panel { animation:menu-appear 150ms ease-out; }
  @keyframes menu-appear { from { opacity:0; } to { opacity:1; } }
}
</style>
