---
import { business } from '../../data/business';
import { navigation } from '../../data/navigation';
import { whatsappLink } from '../../lib/whatsapp';
const path=Astro.url.pathname.replace(/\/$/,'')||'/';
const active=(href:string)=>path===href?'page':undefined;
const sectionActive=(href:string)=>href!=='/'&&path.startsWith(href+'/');
const name=business.displayName??business.registeredName;
---
<header class="site-header" data-header><div class="header-surface"><div class="container header-row">
<a class="brand" href="/" aria-label={`${name} home`}>{name}</a>
<nav class="desktop-nav" aria-label="Primary">{navigation.filter(item=>item.href!=='/').map(item=><a href={item.href} aria-current={active(item.href)} class:list={[{'section-active':sectionActive(item.href)}]}>{item.label}</a>)}</nav>
<a class="enquire" aria-label="Book on WhatsApp" href={whatsappLink()}>Book<span class="wide-label"> on WhatsApp</span></a>
<details class="mobile-nav" data-disclosure><summary aria-label="Menu"><span class="menu-label">Menu</span><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></summary><nav class="mobile-panel" aria-label="Mobile primary">{navigation.map(item=><a href={item.href} aria-current={active(item.href)} class:list={[{'section-active':sectionActive(item.href)}]}>{item.label}</a>)}</nav></details>
</div></div></header>
<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const disclosures = Array.from(header.querySelectorAll<HTMLDetailsElement>('[data-disclosure]'));
    const close = (item: HTMLDetailsElement, restore = false) => {
      item.open = false;
      if (restore) item.querySelector<HTMLElement>(':scope > summary')?.focus();
    };
    // Do not close on focusout: touch activation can move focus before a click.
    // Only a completed outside click or deliberate keyboard focus movement dismisses.
    let keyboardNavigation = false;
    document.addEventListener('pointerdown', () => { keyboardNavigation = false; });
    document.addEventListener('click', event => {
      const path = event.composedPath();
      for (const item of disclosures) {
        if (item.open && !path.includes(item)) close(item);
      }
    });
    document.addEventListener('focusin', event => {
      if (!keyboardNavigation || !(event.target instanceof Node)) return;
      for (const item of disclosures) {
        if (item.open && !item.contains(event.target)) close(item);
      }
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Tab') keyboardNavigation = true;
      if (event.key !== 'Escape') return;
      const target = document.activeElement;
      const open = disclosures.filter(item => item.open && item.contains(target)).at(-1)
        ?? disclosures.find(item => item.open);
      if (open) { event.preventDefault(); close(open, true); }
    });
    const breakpoint = matchMedia('(min-width: 70rem)');
    breakpoint.addEventListener('change', () => disclosures.forEach(item => close(item)));
    // A fixed minimum outer footprint prevents scroll anchoring feedback.
    // Hysteresis prevents rapid state changes near the compact threshold.
    const update = () => {
      const y = window.scrollY;
      if (y >= 112) header.classList.add('compact');
      else if (y <= 56) header.classList.remove('compact');
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>
<style>
.site-header{--header-reserve:5rem;position:sticky;top:0;z-index:20;block-size:calc(var(--header-reserve) + 1px);flex-shrink:0;pointer-events:none}.header-surface{background:var(--white);border-bottom:1px solid var(--border);pointer-events:auto}.header-row{display:grid;grid-template-columns:minmax(0,1fr) auto auto;align-items:center;gap:.5rem;min-height:var(--header-reserve);padding-block:.5rem;position:relative}.compact .header-row{min-height:4.25rem}.brand{font-family:var(--font-editorial);font-weight:600;font-size:clamp(.875rem,1.5vw,1.2rem);line-height:1.25;min-height:44px;display:flex;align-items:center;text-decoration:none}.enquire{background:var(--lavender);color:var(--plum);border-radius:100vw;text-decoration:none;font-size:.875rem;font-weight:500;min-height:44px;display:flex;align-items:center;padding:.65rem .9rem;white-space:nowrap}.enquire:hover{background:var(--border)}nav a,summary{min-height:44px;display:flex;align-items:center;padding:.5rem .65rem;text-decoration:none;font-size:.875rem;font-weight:500;color:var(--muted)}summary{cursor:pointer;list-style:none;gap:.25rem;justify-content:center;min-width:44px;padding-inline:.3rem}summary::-webkit-details-marker{display:none}nav a:hover,[aria-current='page'],.section-active{color:var(--accent-ink);text-decoration:underline;text-underline-offset:.3em}.desktop-nav,.wide-label,.menu-label{display:none}.mobile-panel{position:absolute;top:100%;inset-inline:var(--page-padding);background:var(--white);border:1px solid var(--border);border-radius:var(--radius);padding:.5rem;max-height:calc(100dvh - 6rem);overflow:auto;overscroll-behavior:contain;box-shadow:0 8px 24px #1f1b2e0d}.mobile-panel a{padding-inline:1rem;border-radius:.5rem}.mobile-panel a:hover{background:var(--lavender-soft)}.mobile-panel a:focus-visible{outline-offset:-3px}details:not([open])>.mobile-panel{display:none}
@media(min-width:70rem){.site-header{--header-reserve:5rem}.header-row{grid-template-columns:minmax(0,1fr) auto auto;gap:1.25rem}.compact .header-row{min-height:4rem}.desktop-nav{display:flex;align-items:center;gap:.25rem}.enquire{padding-inline:1.25rem}.wide-label{display:inline;white-space:pre}.mobile-nav{display:none}}
@media(prefers-reduced-motion:no-preference){.mobile-nav[open] .mobile-panel{animation:menu-appear 250ms ease-out}@keyframes menu-appear{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:none}}}
</style>
