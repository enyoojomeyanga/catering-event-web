---
import {business} from '../../data/business';
import {navigation} from '../../data/navigation';
const international=(phone:string)=>`+234 ${phone.slice(1,4)} ${phone.slice(4,7)} ${phone.slice(7)}`;
---
<footer class="footer"><div class="container"><div class="footer-grid"><div class="identity"><a class="footer-brand" href="/">{business.registeredName}</a><p>Catering, event decoration, custom cakes, small chops and confectionery for your occasions.</p></div><nav aria-label="Footer" class="footer-links"><h2>Quick links</h2>{navigation.filter(item=>item.href!=='/').map(item=><a href={item.href}>{item.label}</a>)}</nav><div class="footer-contact"><h2>Contact</h2><a href={`mailto:${business.email}`}>{business.email}</a>{business.phones.map(phone=><a href={`tel:+234${phone.slice(1)}`}>{international(phone)}</a>)}<p>Idah · Anyigba, Kogi State</p></div></div><p class="copyright">Copyright © {business.registeredName} {new Date().getFullYear()}</p></div></footer>
<style>.footer{background:var(--lavender-soft);border-top:1px solid var(--border);padding-block:3rem;color:var(--muted);font-size:1rem}.footer-grid{display:grid;gap:2rem}.identity{display:grid;gap:1.25rem;align-content:start}.footer-brand{font-family:var(--font-editorial);font-size:1.5rem;line-height:1.25;font-weight:600;color:var(--plum);text-decoration:none}.identity p{max-width:36ch}.footer h2{font:600 .75rem/1.5 var(--font-body);text-transform:uppercase;letter-spacing:.08em;margin-bottom:.5rem}.footer-links,.footer-contact{display:grid;align-content:start;gap:.15rem;min-width:0}.footer-links a,.footer-contact a{display:flex;align-items:center;min-height:44px;text-decoration:none;overflow-wrap:anywhere}.footer a:hover{text-decoration:underline;color:var(--accent-ink)}.copyright{border-top:1px solid var(--border);padding-top:1.5rem;margin-top:2.5rem;font-size:.75rem;max-width:none;text-align:center}@media(min-width:48rem){.footer-grid{grid-template-columns:2fr 1fr 1.25fr;gap:2.5rem}.copyright{text-align:left}}</style>
