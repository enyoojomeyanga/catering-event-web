---
import { business } from '../../data/business';
---
<footer class="inverse footer"><div class="container footer-inner"><nav aria-label="Footer">{[{href:'/',label:'Home'},{href:'/services',label:'Services'},{href:'/gallery',label:'Gallery'},{href:'/about',label:'About'},{href:'/faq',label:'FAQs'},{href:'/contact',label:'Contact'}].map(item=><a href={item.href}>{item.label}</a>)}</nav><p class="copyright">© {new Date().getFullYear()} {business.registeredName}</p></div></footer>
<style>.footer{padding-block:2rem}.footer-inner{display:grid;gap:1rem}nav{display:flex;justify-content:center;flex-wrap:wrap;gap:.25rem 1.5rem}a{display:flex;align-items:center;min-height:44px}.copyright{border-top:1px solid var(--color-brand-blush);padding-top:1.25rem;text-align:center;max-width:none;width:100%;font-size:.875rem}</style>
