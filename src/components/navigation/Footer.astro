---
import {business} from '../../data/business';
import {navigation} from '../../data/navigation';
---
<footer class="footer"><div class="container"><div class="footer-grid"><div class="identity"><a class="footer-brand" href="/">{business.registeredName}</a><p>Catering, event decoration, custom cakes, small chops and confectionery for your occasions.</p></div><nav aria-label="Footer" class="footer-links"><h2>Quick links</h2><div class="footer-link-grid">{navigation.map(item=><a href={item.href}>{item.label}</a>)}</div></nav></div><div class="footer-bottom"><p class="copyright">© {new Date().getFullYear()} {business.registeredName}</p><a class="top-link" href="#page-top" data-footer-top>Back to top <span aria-hidden="true">↑</span></a></div></div></footer>
<style>
.footer{background:var(--lavender-soft);border-top:1px solid var(--border);padding-block:var(--page-start);color:var(--muted);font-size:var(--type-link)}
.footer-grid{display:grid;gap:var(--action-gap)}.identity{display:grid;gap:var(--heading-gap);align-content:start;min-width:0}
.footer-brand{font-family:var(--font-editorial);font-size:var(--type-h3);line-height:1.25;font-weight:600;color:var(--plum);text-decoration:none}.identity p{max-width:42ch}
.footer h2{font:600 var(--type-link)/1.5 var(--font-body);text-transform:uppercase;letter-spacing:.08em;margin-bottom:.5rem}
.footer-links{min-width:0}.footer-link-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 1rem}.footer-link-grid a{display:flex;align-items:center;min-height:44px;text-decoration:none;overflow-wrap:anywhere}.footer a:hover{color:var(--accent-ink)}
.footer-bottom{border-top:1px solid var(--border);padding-top:var(--heading-gap);margin-top:var(--action-gap);display:grid;justify-items:center;gap:.25rem}.copyright{font-size:var(--type-caption);max-width:none;text-align:center}.top-link{display:inline-flex;gap:.5rem;align-items:center;min-height:44px;font-size:var(--type-link);color:var(--accent-ink)}
@media(min-width:48rem){.footer-grid{grid-template-columns:minmax(0,3fr) minmax(0,2fr);gap:var(--major-space)}}
</style>
